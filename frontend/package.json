{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test:bundle": "node scripts/check-bundle-budget.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test:uat:conversation": "node scripts/uat-conversation.mjs",
    "test:uat:knowledge": "node scripts/uat-project-knowledge.mjs",
    "test:uat:notebook": "node scripts/uat-notebook.mjs",
    "test:uat:office": "node scripts/uat-office-preview.mjs",
    "test:visual": "pnpm build && playwright test --config playwright.visual.config.ts",
    "test:visual:typecheck": "tsc -p tests/visual/tsconfig.json",
    "test:visual:update": "pnpm build && playwright test --config playwright.visual.config.ts --update-snapshots",
    "test:accessibility": "pnpm build && playwright test --config playwright.visual.config.ts --grep @accessibility",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@pi-science/contracts": "workspace:*",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/source-serif-4": "^5.2.9",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@tanstack/react-query": "^5.101.4",
    "autoprefixer": "^10.5.2",
    "clsx": "^2.1.1",
    "docx-preview": "^0.4.0",
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "highlight.js": "^11.11.1",
    "i18next": "^26.3.6",
    "katex": "^0.16.47",
    "lucide-react": "^1.34.0",
    "molstar": "^5.11.0",
    "openchemlib": "^9.24.0",
    "postcss": "^8.5.16",
    "pptx-preview": "^1.0.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.9",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "react-virtuoso": "^4.18.11",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19",
    "three": "^0.185.1",
    "uuid": "^11.1.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.1.0",
    "docx": "^9.7.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "playwright-core": "^1.62.1",
    "pptxgenjs": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "echarts": "^6.1.0",
    "uuid": "^11.1.1"
  }
}
