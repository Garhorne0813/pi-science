# Force LF line endings for text files that are parsed as YAML/markdown.
# Windows checkouts (git autocrlf) previously turned SKILL.md into CRLF,
# which broke the yaml parser (values parsed with a trailing \r).
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Keep source formatting and legacy format hashes stable on Windows.
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
