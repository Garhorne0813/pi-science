{
  "name": "@pi-science/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:native": "node scripts/build-workspace-discovery-native.mjs --required",
    "build": "node scripts/build-workspace-discovery-native.mjs && tsc -p tsconfig.build.json && node scripts/copy-kernel-bridges.mjs && node scripts/copy-sqlite-assets.mjs && node scripts/build-web-core.mjs",
    "dev": "node scripts/build-workspace-discovery-native.mjs && tsx watch src/app/main.ts",
    "start": "node dist/app/main.js",
    "test": "node --test scripts/build-workspace-discovery-native.test.mjs && node scripts/build-workspace-discovery-native.mjs && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --deny-warnings src && pnpm lint:async",
    "lint:async": "oxlint --type-aware --deny-warnings --config .oxlintrc.async.json src"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.79",
    "@earendil-works/pi-agent-core": "0.99.2",
    "@earendil-works/pi-ai": "0.99.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/http-proxy": "^11.6.0",
    "@fastify/rate-limit": "^11.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@pi-science/contracts": "workspace:*",
    "defuddle": "0.19.3",
    "fastify": "^5.10.0",
    "ignore": "^7.0.14",
    "jszip": "^3.10.1",
    "pi-web-access": "0.40.0",
    "picomatch": "^4.0.7",
    "re2-wasm": "^1.0.2",
    "typebox": "1.3.27",
    "undici": "^7.29.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/picomatch": "^4.0.3",
    "esbuild": "0.28.1",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
